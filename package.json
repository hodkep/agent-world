{
  "name": "agent-world",
  "version": "0.5.1",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "node scripts/run-tests.mjs",
    "pilot:library": "PILOT=1 vitest run -c vitest.pilot.config.ts",
    "test:e2e": "electron-vite build && playwright test",
    "verify:local": "node scripts/verify-local.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "shots": "node scripts/shots.mjs",
    "readme:art": "node --experimental-strip-types --no-warnings scripts/readme-art.mjs",
    "postinstall": "electron-rebuild -f -w node-pty",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "pack": "node scripts/fetch-git.mjs --platform && electron-vite build && electron-builder --dir; electron-rebuild -f -w node-pty",
    "dist": "node scripts/fetch-git.mjs --platform && electron-vite build && electron-builder; electron-rebuild -f -w node-pty"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ],
    "overrides": {
      "dompurify": "^3.4.17",
      "katex": "^0.18.10",
      "lodash-es": "^4.18.1",
      "source-map-js": "^1.2.2"
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "dompurify": "^3.4.16",
    "electron-updater": "^6.8.9",
    "katex": "^0.18.10",
    "marked": "^18.0.14",
    "marked-alert": "^2.1.2",
    "marked-footnote": "^1.4.0",
    "marked-gfm-heading-id": "^4.1.4",
    "marked-katex-extension": "^5.1.13",
    "mermaid": "^12.0.0",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.1.0",
    "pixi.js": "^8.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "description": "Run and steer Claude Code and Antigravity agents from a pixel-art office: each agent gets its own git worktree, chat, terminal and diff view, with approval gates, workflows, a shared skills library and a todo board. macOS.",
  "author": "Pratik <agentworld.app@gmail.com>",
  "repository": "github:hodkep/agent-world",
  "homepage": "https://github.com/hodkep/agent-world#readme",
  "bugs": "https://github.com/hodkep/agent-world/issues",
  "license": "Apache-2.0"
}
